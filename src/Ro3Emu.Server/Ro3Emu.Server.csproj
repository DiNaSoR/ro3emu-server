<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- One latency-bound game loop: workstation concurrent GC measured p99 pause 10 ms and 1.6 GB working set in a
         500-login storm, against 118 ms and 2.9 GB with the web SDK's default server GC. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MessagePack" Version="3.1.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phonest gate schemas, regenerated from the client's Phonest.Proto descriptors (tools/ProtoDump). -->
    <Protobuf Include="Protos\phonest\*.proto" ProtoRoot="Protos\phonest" GrpcServices="None" />
    <!-- RO3 game messages (package romsg & co.), regenerated from the client's LocalProto/proto.pb.bytes. -->
    <Protobuf Include="Protos\romsg\*.proto" ProtoRoot="Protos\romsg" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ro3Emu.Tests" />
    <!-- Embedded only: no loose copies next to the server binary. -->
    <Content Remove="Reconstructed\**" />
    <EmbeddedResource Include="Reconstructed\dungeon-monsters.json" LogicalName="Ro3Emu.Server.Reconstructed.dungeon-monsters.json" />
    <EmbeddedResource Include="Reconstructed\scripted-scenes.json" LogicalName="Ro3Emu.Server.Reconstructed.scripted-scenes.json" />
  </ItemGroup>

</Project>
