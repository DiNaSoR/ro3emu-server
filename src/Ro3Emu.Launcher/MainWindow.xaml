<Window x:Class="Ro3Emu.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RO3Emu" Width="1180" Height="740" ResizeMode="CanMinimize"
        WindowStyle="None" WindowStartupLocation="CenterScreen" Background="#EFE6CC">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
        <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#EFE6CC" />
    </Grid>
</Window>
