<Project>
  <!-- Distro-built .NET (Arch, CachyOS, ...) runs under its own runtime id, such as arch-x64, so the SDK asks NuGet for
       Microsoft.NETCore.App.Host.arch-x64, which does not exist (NU1101). Use the portable linux apphost there instead,
       so plain dotnet build, run and publish work without -r linux-x64. Microsoft's own builds (linux-x64,
       linux-musl-x64, win-*, osx-*) are left alone. -->
  <PropertyGroup>
    <_Ro3HostRid>$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier)</_Ro3HostRid>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DefaultAppHostRuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux')) and
                            !$(_Ro3HostRid.StartsWith('linux-'))">
    <DefaultAppHostRuntimeIdentifier>linux-$(_Ro3HostRid.Substring($([MSBuild]::Add($(_Ro3HostRid.LastIndexOf('-')), 1))))</DefaultAppHostRuntimeIdentifier>
  </PropertyGroup>

  <!-- Quality gates shared by every project; each project file keeps its own target framework and features. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- A known vulnerable package (NU1901-NU1904) is reported without failing the build; Dependabot proposes the fix. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- Rules broken by code that predates this setting are listed, with their counts, in .editorconfig. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
